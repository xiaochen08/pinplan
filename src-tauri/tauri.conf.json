{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinPlan",
  "version": "0.1.0",
  "identifier": "com.pinplan.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PinPlan",
        "width": 328,
        "height": 468,
        "minWidth": 300,
        "minHeight": 320,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false,
        "focus": true
      },
      {
        "label": "popup",
        "url": "index.html#/popup",
        "title": "PinPlan Check-in",
        "width": 320,
        "height": 236,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "dock",
        "url": "index.html#/dock",
        "title": "PinPlan Edge Pin",
        "width": 56,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "maximizable": false,
        "minimizable": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
